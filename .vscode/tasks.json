{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Agent Orchestrator API",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/bin/python",
			"args": [
				"-m",
				"uvicorn",
				"app.main:app",
				"--reload",
				"--reload-dir",
				"app",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run Orchestrator Frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"${workspaceFolder}/frontend",
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1",
				"--port",
				"5173"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}