FROM python:3.11-slim

# Keep logs unbuffered and avoid generated bytecode in the image.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Cache third-party dependencies independently from application changes.
COPY requirements.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt

# Install the editable package to expose the orch command globally.
COPY pyproject.toml README.md ./
COPY app/ ./app/
COPY cli/ ./cli/
COPY tests/ ./tests/
RUN python -m pip install --no-cache-dir -e .

EXPOSE 8000

# One worker owns the in-memory runs and background tasks.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]